<Window x:Class="CodexVoiceAssistant.App.OrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1280"
        Height="60"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#FF07111A"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">
  <Canvas x:Name="RootCanvas" ClipToBounds="True">
    <Polygon x:Name="FramePolygon"
             Fill="#F20A1622"
             Stroke="#FF39D9FF"
             StrokeThickness="2" />
    <Polyline x:Name="LeftWave"
              Stroke="#FF64EAFF"
              StrokeThickness="2" />
    <Polyline x:Name="RightWave"
              Stroke="#FF7A67FF"
              StrokeThickness="2" />
  </Canvas>
</Window>
